# Copy to .env and adjust. Never commit the real .env.

CIIP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CIIP_JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes!!
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CIIP_DATA_ENCRYPTION_KEY=Y2lpcC1kZW1vLWtleS1kby1ub3QtdXNlLWluLXByb2Q=
POSTGRES_PASSWORD=ciip-dev-password

CIIP_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
CIIP_ACCESS_TOKEN_MINUTES=15
CIIP_REFRESH_TOKEN_DAYS=7

# Local LLM (Ollama). Set CIIP_AI_USE_OLLAMA=false to use only the rules engine.
CIIP_AI_USE_OLLAMA=true
CIIP_OLLAMA_MODEL=llama3.2:3b

# Load the fictional demo dataset at startup (idempotent).
CIIP_SEED_DEMO=true
